<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 앱 안 업데이트: 새 버전 확인·다운로드와 설치 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- 정해진 시간에 딱 맞춰 전체 화면 알림을 띄우기 위한 정확한 알람과 전체 화면 알림 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_label_hidden"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 홈 화면 이름은 여기(activity label)로 정해지고, 알림 맨 위 앱 이름은 위의 application label 이 쓰인다 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 잠금을 풀지 않고 잠금화면 위에 바로 뜨는 한 줄 메모 입력창 -->
        <activity
            android:name=".QuickMemoActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=".quickmemo"
            android:theme="@style/QuickMemoTheme"
            android:turnScreenOn="true"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".MemoActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".DueAlarm$Receiver"
            android:exported="false" />

        <!-- 정해진 시간이 됐을 때 잠금화면 위에 전체 화면으로 뜨는 알림 -->
        <activity
            android:name=".DueAlertActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=".duealert"
            android:theme="@style/DueAlertTheme"
            android:turnScreenOn="true" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 잠금화면에서 알림창을 내려 바로 누를 수 있는 빠른 설정 타일 -->
        <service
            android:name=".QuickMemoTileService"
            android:exported="true"
            android:icon="@drawable/ic_memo"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
